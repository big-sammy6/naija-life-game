<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Will Parfitt & Magic Men | Tour Tickets & VIP Booking</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: { 400: '#facc15', 500: '#eab308', 600: '#ca8a04' },
                        darkBg: '#0b0b0f',
                        cardBg: '#14141d',
                        cardHover: '#1c1c28',
                    }
                }
            }
        }
    </script>
    <!-- EmailJS SDK Integration -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <script type="text/javascript">
       (function(){
          emailjs.init("UTdh6nzwAwnRa4Jir");
       })();
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b0b0f; color: #f3f4f6; overflow-x: hidden; }
        .gold-gradient-text { background: linear-gradient(135deg, #FFF5C0 0%, #E2B042 50%, #9B6A1A 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .gold-border-glow { box-shadow: 0 0 15px rgba(234, 179, 8, 0.25); }
    </style>
</head>
<body class="bg-darkBg text-gray-100 min-h-screen flex flex-col justify-between">

    <!-- NAVIGATION -->
    <nav class="fixed top-0 left-0 w-full z-40 bg-darkBg/90 backdrop-blur-md border-b border-gray-800">
        <div class="max-w-7xl mx-auto px-4 h-20 flex items-center justify-between">
            <a href="#" class="text-2xl font-black tracking-widest text-white uppercase">
                WILL<span class="gold-gradient-text">PARFITT</span>
            </a>
            <div class="flex items-center gap-4">
                <span class="bg-cardBg border border-gray-700 px-3 py-1.5 rounded-xl text-xs font-semibold text-yellow-400">
                    <i class="fa-solid fa-shield-halved mr-1"></i> Live VIP Portal
                </span>
            </div>
        </div>
    </nav>

    <!-- HERO & BOOKING FORM -->
    <section class="pt-32 pb-20 max-w-7xl mx-auto px-4 w-full grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
            <span class="bg-yellow-500/10 border border-yellow-500/30 text-yellow-400 text-xs font-semibold px-4 py-1.5 rounded-full uppercase tracking-widest">
                Official 2026 World Tour & VIP Experiences
            </span>
            <h1 class="text-4xl sm:text-6xl font-black uppercase tracking-tight">
                WILL PARFITT <br><span class="gold-gradient-text">LIVE & VIP ACCESS</span>
            </h1>
            <p class="text-gray-300 text-base max-w-xl mx-auto lg:mx-0">
                Experience Australia & the UK’s premier entertainment star live on stage with Magic Men Australia, or secure exclusive private 1-on-1 virtual sessions.
            </p>
        </div>

        <!-- DIRECT VIP BOOKING CARD -->
        <div class="lg:col-span-5 bg-cardBg border border-yellow-500/30 p-6 sm:p-8 rounded-3xl shadow-xl gold-border-glow">
            <h3 class="text-xl font-bold uppercase tracking-wider text-white mb-6 border-b border-gray-800 pb-4">
                <i class="fa-solid fa-user-pen text-yellow-400"></i> Book 1-on-1 Meet & Greet
            </h3>

            <form id="meet-form" onsubmit="handleMeetBookingSubmit(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-300 mb-2">Full Name</label>
                    <input type="text" id="meet-name" required placeholder="e.g. Sammy" class="w-full bg-darkBg border border-gray-700 rounded-xl px-4 py-3 text-sm text-white focus:border-yellow-500 outline-none">
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase text-gray-300 mb-2">Email Address</label>
                    <input type="email" id="meet-email" required placeholder="samuelanyibema308@gmail.com" class="w-full bg-darkBg border border-gray-700 rounded-xl px-4 py-3 text-sm text-white focus:border-yellow-500 outline-none">
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase text-gray-300 mb-2">Preferred Crew Member</label>
                    <select id="meet-crew-select" class="w-full bg-darkBg border border-gray-700 rounded-xl px-4 py-3 text-sm text-white focus:border-yellow-500 outline-none">
                        <option value="Will Parfitt">Will Parfitt (Main Star)</option>
                        <option value="Brad">Brad (Senior Crew)</option>
                        <option value="Liam">Liam (Dancer & Host)</option>
                        <option value="Sean">Sean (Acrobat Lead)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase text-gray-300 mb-2">Preferred Date</label>
                    <input type="date" id="meet-date" required class="w-full bg-darkBg border border-gray-700 rounded-xl px-3 py-3 text-sm text-white focus:border-yellow-500 outline-none">
                </div>

                <button type="submit" id="meet-submit-btn" class="w-full bg-yellow-500 hover:bg-yellow-600 text-black font-extrabold py-4 rounded-xl uppercase tracking-wider text-sm transition-colors shadow-lg">
                    Confirm Booking Request
                </button>
            </form>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-black border-t border-gray-800 py-6 text-center text-xs text-gray-500">
        © 2026 Will Parfitt & Magic Men Australia Entertainment. All rights reserved.
    </footer>

    <!-- EMAILJS SCRIPT -->
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const dateInput = document.getElementById('meet-date');
            if(dateInput) {
                const futureDate = new Date();
                futureDate.setDate(futureDate.getDate() + 3);
                dateInput.value = futureDate.toISOString().split('T')[0];
            }
        });

        function handleMeetBookingSubmit(e) {
            e.preventDefault();
            const submitBtn = document.getElementById('meet-submit-btn');
            submitBtn.innerText = "Sending Booking Notification...";
            submitBtn.disabled = true;

            const name = document.getElementById('meet-name').value;
            const email = document.getElementById('meet-email').value;
            const crew = document.getElementById('meet-crew-select').value;
            const date = document.getElementById('meet-date').value;

            const templateParams = {
                user_name: name,
                user_email: email,
                crew_member: crew,
                booking_date: date
            };

            emailjs.send('service_sg21cuj', 'template_9vqcewt', templateParams)
                .then(function() {
                    alert('Success! Your VIP booking request has been sent to your email.');
                    document.getElementById('meet-form').reset();
                    submitBtn.innerText = "Confirm Booking Request";
                    submitBtn.disabled = false;
                }, function(error) {
                    alert('Failed to send booking request. Please check your connection.');
                    console.error('EmailJS Error:', error);
                    submitBtn.innerText = "Confirm Booking Request";
                    submitBtn.disabled = false;
                });
        }
    </script>
</body>
</html>
